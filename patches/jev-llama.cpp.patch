+bool llama_model::joyfox_jev_scores(const float * query, const float * options, uint32_t n_options, uint32_t n_embd, float * scores) const {
+    if (query == nullptr || options == nullptr || scores == nullptr || n_options == 0 || n_options > 128 ||
+            n_embd != hparams.n_embd || jev_query_f32.size() != 128 * n_embd || jev_query_bias_f32.size() != 128 ||
+            jev_key_f32.size() != 128 * n_embd || jev_key_bias_f32.size() != 128) {
+        return false;
+    }
+    std::vector<float> query_projected(128);
+    for (size_t d = 0; d < 128; ++d) {
+        float value = jev_query_bias_f32[d];
+        for (size_t h = 0; h < n_embd; ++h) {
+            value += jev_query_f32[d * n_embd + h] * query[h];
+        }
+        query_projected[d] = value;
+    }
+    for (uint32_t option = 0; option < n_options; ++option) {
+        float score = 0.0f;
+        for (size_t d = 0; d < 128; ++d) {
+            float key = jev_key_bias_f32[d];
+            for (size_t h = 0; h < n_embd; ++h) {
+                key += jev_key_f32[d * n_embd + h] * options[(size_t) option * n_embd + h];
+            }
+            score += query_projected[d] * key;
+        }
+        scores[option] = score / sqrtf(128.0f);
+    }
+    return true;
+}
+
+bool llama_model_joyfox_jev_scores(const struct llama_model * model, const float * query, const float * options, uint32_t n_options, uint32_t n_embd, float * scores) {
+    return model != nullptr && model->joyfox_jev_scores(query, options, n_options, n_embd, scores);
+}
