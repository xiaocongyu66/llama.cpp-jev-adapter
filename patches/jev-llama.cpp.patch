+def _is_joyfox_jev_checkpoint(dir_model: Path) -> bool:
+    required = ("decision_config.json", "head.safetensors", "backbone/config.json", "tokenizer/tokenizer.json")
+    if not all((dir_model / name).is_file() for name in required):
+        return False
+    try:
+        with open(dir_model / "backbone" / "config.json", encoding="utf-8") as f:
+            config = json.load(f)
+        with open(dir_model / "decision_config.json", encoding="utf-8") as f:
+            decision = json.load(f)
+    except json.JSONDecodeError:
+        return False
+    return (
+        config.get("model_type") == "qwen3_5_text"
+        and config.get("hidden_size") == 1024
+        and decision.get("head_dim") == 128
+        and decision.get("format_version") == 2
+        and decision.get("adapter") is False
+        and decision.get("execution") == "rows"
+    )
+
+
+@ModelBase.register_hparams_loader(_is_joyfox_jev_checkpoint)
+def _load_joyfox_jev_hparams(dir_model: Path) -> dict[str, Any]:
+    logger.info("gguf: detected JoyFox JEV checkpoint")
+    hparams = ModelBase.load_hparams(dir_model / "backbone", False, guess=False)
+    hparams["architectures"] = ["JoyFoxJevModel"]
+    return hparams
+
+
+@ModelBase.register("JoyFoxJevModel")
+@ModelBase.example("joyfox/Qwen3.5-0.8B-JEV")
+class JoyFoxJevModel(Qwen3_5TextModel):
+    no_mtp = True
+
+    def __init__(self, dir_model, *args, **kwargs):
+        self.jev_root = dir_model
+        hparams = kwargs.pop("hparams", None)
+        if hparams is None:
+            hparams = ModelBase.load_hparams(dir_model / "backbone", self.is_mistral_format)
+        _LinearAttentionVReorderBase.__init__(self, dir_model / "backbone", *args, hparams=hparams, **kwargs)
+        self.dir_model_card = dir_model
+        self.tokenizer_dir = dir_model / "tokenizer"
+
+    def set_vocab(self):
+        self._set_vocab_gpt2()
+        template_path = self.tokenizer_dir / "chat_template.jinja"
+        if template_path.is_file():
+            self.gguf_writer.add_chat_template(template_path.read_text(encoding="utf-8"))
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        self.gguf_writer.add_decision_type(gguf.DecisionType.JOYFOX_JEV)
+        self.gguf_writer.add_embedding_length_out(1024)
+
+    def generate_extra_tensors(self) -> Iterable[tuple[str, Tensor]]:
+        yield from super().generate_extra_tensors()
+        from safetensors.torch import load_file
+        head = load_file(self.jev_root / "head.safetensors")
+        expected = {"query.weight", "query.bias", "key.weight", "key.bias"}
+        if set(head) != expected:
+            raise ValueError("JoyFox JEV head must contain query/key weights and biases")
+        shapes = {"query.weight": (128, 1024), "key.weight": (128, 1024), "query.bias": (128,), "key.bias": (128,)}
+        for source, tensor in head.items():
+            if tuple(tensor.shape) != shapes[source]:
+                raise ValueError(f"invalid JoyFox JEV tensor shape for {source}: {tuple(tensor.shape)}")
+            target = {
+                "query.weight": "decision.query.weight",
+                "query.bias": "decision.jev_query_bias",
+                "key.weight": "decision.key.weight",
+                "key.bias": "decision.jev_key_bias",
+            }[source]
+            yield target, tensor
+
+
 def _is_openjev_checkpoint(dir_model: Path) -> bool:
     return (dir_model / "helper" / "shim.py").is_file() and (dir_model / "config.json").is_file()
 
